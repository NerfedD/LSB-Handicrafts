VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Temporary admin allowlist (comma-separated emails). Whoever signs in with
# one of these gets into the dashboard; everyone else is signed back out.
VITE_ADMIN_EMAILS=admin@example.com

# Minutes of inactivity before a signed-in user is signed out. 30-60 is the
# intended range; omit it to use the 30-minute default.
VITE_IDLE_TIMEOUT_MINUTES=30
