VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Temporary admin allowlist (comma-separated emails). Whoever signs in with
# one of these gets into the dashboard; everyone else is signed back out.
VITE_ADMIN_EMAILS=admin@example.com

# Minutes of inactivity before a signed-in user is signed out. 30-60 is the
# intended range; omit it to use the 30-minute default.
VITE_IDLE_TIMEOUT_MINUTES=30

# The office line, shown on the sign-in screen and on the two sign-in problems
# a user cannot fix themselves (blocked account, no role assigned). Without it
# the UI falls back to the design mockup's placeholder, (082) 000 0000, which
# is not a real number -- set this before staff use the system.
VITE_OFFICE_PHONE=(082) 000 0000
